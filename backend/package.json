{
  "name": "genesis-miner-backend",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx prisma generate && npm run build:server && node server.js",
    "build:cron": "tsc -p tsconfig.cron.json",
    "build:ts": "tsc -p tsconfig.json",
    "build:server": "npm run build:ts && tsc -p tsconfig.server.json",
    "build:app": "npx prisma generate && rm -rf dist/cron 2>/dev/null && npm run build:cron && npm run build:server && mkdir -p dist/lib && cp lib/miningLivePrices.js dist/lib/miningLivePrices.js",
    "prestart": "npm run build:app",
    "start": "node server.js",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:cov": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "db:pull": "npx prisma db pull",
    "schema:validate": "npx prisma validate",
    "migrate:deploy": "npx prisma migrate deploy",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:status": "npx prisma migrate status"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "*",
    "@prisma/client": "^6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "*",
    "bullmq": "^5.63.0",
    "cors": "*",
    "ethers": "^6.15.0",
    "dotenv": "*",
    "express": "*",
    "express-rate-limit": "*",
    "helmet": "*",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "prisma": "^6.19.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^6.4.23",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  }
}
